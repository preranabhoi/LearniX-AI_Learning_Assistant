# Server Configuration
PORT=8000
NODE_ENV=production

# MongoDB Connection String (e.g., MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/LearniX?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# File Upload Settings
MAX_FILE_SIZE=10485760

# Optional: Client URL for CORS (or * for all)
CLIENT_URL=*
